{
  "manifest_version": 3,
  "name": "ChatGPT MultiChat Monitor",
  "version": "0.2.7",
  "description": "A lightweight floating monitor for active ChatGPT conversations across browser tabs.",
  "permissions": ["storage", "tabs", "scripting", "offscreen"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "background.js"},
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "ChatGPT MultiChat Monitor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    }
  },
  "commands": {
    "toggle-monitor": {
      "suggested_key": {"default": "Alt+Shift+M"},
      "description": "Show or hide the monitor on the active ChatGPT tab"
    },
    "next-working-chat": {
      "suggested_key": {"default": "Ctrl+Shift+1"},
      "description": "Focus the next working ChatGPT tab"
    },
    "next-attention-chat": {
      "suggested_key": {"default": "Ctrl+Shift+2"},
      "description": "Focus the next attention or unread Done ChatGPT tab"
    }
  }
}
